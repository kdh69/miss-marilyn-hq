{
  "name": "miss-marilyn",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "sheet:setup": "tsx --env-file-if-exists=.env scripts/setup-sheet.ts",
    "sheet:xlsx": "node --env-file-if-exists=.env scripts/py.mjs scripts/build_sheet_xlsx.py",
    "backend": "npm run run -w @mm/backend",
    "web": "npm run dev -w @mm/web",
    "typecheck": "tsc -p packages/core && tsc -p apps/backend && tsc -p scripts",
    "doctor": "npm run doctor -w @mm/backend",
    "dryrun": "npm run dryrun -w @mm/backend",
    "qc": "npm run qc -w @mm/backend --",
    "google:authorize": "tsx --env-file-if-exists=.env scripts/google-authorize.ts",
    "test": "vitest run",
    "test:preflight": "node --env-file-if-exists=.env scripts/py.mjs -m unittest discover -s apps/backend/preflight/tests -v",
    "check": "npm run typecheck && npm test && npm run test:preflight && npm run build -w @mm/web"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.9"
  }
}
