# Copy to .env and fill in. Never commit .env (it's gitignored).
# Scripts load it automatically (npm run doctor / dryrun / backend / sheet:setup).

# --- Google: service account (GCP → IAM → Service accounts → Keys → JSON) ---
# Paste the whole JSON on ONE line, wrapped in single quotes.
GOOGLE_SERVICE_ACCOUNT_JSON=''
MM_CORE_SHEET_ID=1YAZyJ6mBA5Y02r3mO7svqet9nHI53rtBXO3eYWEMZkY

# --- Claude QC ---
ANTHROPIC_API_KEY=

# --- Alerts and Clara's weekly email (Resend, after the domain is verified) ---
KYLE_EMAIL=
CLARA_EMAIL=
RESEND_API_KEY=
NOTIFY_FROM="Miss Marilyn HQ <hq@your-domain.com>"
PANEL_URL=https://your-panel.vercel.app

# --- Control panel sign-in (GCP → APIs & Services → Credentials → OAuth client ID → Web app) ---
# Redirect URIs: https://<vercel-domain>/api/auth/callback/google  and  http://localhost:5179/oauth2callback
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# any long random string: openssl rand -base64 32
AUTH_SECRET=
# who can sign in, and as whom
PANEL_USERS=clara@example.com:mom,kyle@example.com:kyle

# --- Only if doctor says uploads need it: npm run google:authorize ---
GOOGLE_OWNER_REFRESH_TOKEN=
